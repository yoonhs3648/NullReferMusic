+import { YTNode } from '../helpers.js';
+import { Parser } from '../index.js';
+import Button from './Button.js';
+import ChipCloud from './ChipCloud.js';
+/** Android InnerTube search header (`searchMobileHeaderRenderer`). */
+export default class SearchMobileHeader extends YTNode {
+    static type = 'SearchMobileHeader';
+    chip_bar;
+    search_filter_button;
+    constructor(data) {
+        super();
+        this.chip_bar = Parser.parseItem(data.chipBar, ChipCloud);
+        this.search_filter_button = Parser.parseItem(data.searchFilterButton, Button);
+    }
+}
+//# sourceMappingURL=SearchMobileHeader.js.map
