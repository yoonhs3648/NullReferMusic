{
  "name": "nullrefer-music-app",
  "main": "index",
  "version": "2.6.4",
  "scripts": {
    "start": "expo start --lan",
    "start:plain": "expo start",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --lan --clear",
    "start:web": "expo start --web",
    "start:dev-client": "expo start --lan --dev-client",
    "android": "expo run:android",
    "android:release": "node scripts/assemble-android-release.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "generate:notification-icon": "node scripts/generate-android-notification-icon.mjs",
    "generate:music-quotes": "node scripts/build-music-quotes.mjs",
    "generate:github-data-fields": "node scripts/generate-github-data-fields-xlsx.mjs",
    "generate:home-chart-assets": "node scripts/tint-home-chart-assets.mjs",
    "sync:brand": "node scripts/sync-nrm-brand.mjs",
    "preandroid:release": "npm run sync:brand && npm run generate:music-quotes"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nrm-audio-metadata": "file:./modules/nrm-audio-metadata",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "youtubei.js": "17.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  },
  "private": true
}
