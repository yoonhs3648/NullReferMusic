# EAS Build 제외 목록
# .gitignore 를 대체 — android/ 폴더는 반드시 포함되어야 Chaquopy 빌드가 동작함

# 의존성 (클라우드에서 재설치)
node_modules/

# Expo 임시 파일
.expo/
dist/
web-build/
expo-env.d.ts

# Android 빌드 캐시만 제외 (소스는 포함)
android/.gradle/
android/build/
android/app/build/
android/.cxx/

# iOS (Android 빌드에서 불필요)
ios/

# 기타
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
