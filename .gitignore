# 다운로드 산출물 (로컬 전용)
/downloads/

# 로컬 샘플 미디어 (형상관리 제외)
sample/

# 의존성
app/node_modules/
server/node_modules/

# Spring Boot
backend/target/

# Expo / 네이티브 생성물
app/.expo/
# app/android/ — 온디바이스 yt-dlp(Chaquopy)·커스텀 모듈 포함으로 버전 관리함
app/ios/
app/dist/

# 로그·OS
*.log
.DS_Store
Thumbs.db

# 루트 임시·테스트 파일
/.build-release-apk-custom/
/*.json
/*.html

# GitHub data PAT (APK 빌드용 — 절대 커밋 금지)
.secrets/nrm-github-data.pat

# Excel 임시 잠금 파일 (Office)
~$*.xlsx

# Whisper 로컬 바이너리/모델 (대용량 산출물)
library/whisper/*.bin
library/whisper/*.dll
library/whisper/*.exe
library/whisper/*.zip
library/whisper/_bin/
library/whisper/_src_whisper_cpp/

# wav2vec2-base FA ONNX (HF 업로드 전 로컬 export)
library/wav2vec2-base-int8/*.onnx
library/wav2vec2-base-int8/onnx-export/
library/wav2vec2-base-en/*.onnx
library/wav2vec2-base-en/onnx-export/model.onnx
library/.hf-token.local

library/libretranslate/_vendor/
library/libretranslate/_bin/

# Whisper APK assets — ggml 모델만 제외 (CLI·libomp.so는 형상관리)
app/android/app/src/main/assets/whisper/ggml-*.bin

app/android/app/src/main/assets/libretranslate/nrm-argos-translate
app/android/app/src/main/assets/libretranslate/**/*.so
app/android/app/src/main/assets/libretranslate/**/nrm-argos-translate
app/android/.gradle-home/
