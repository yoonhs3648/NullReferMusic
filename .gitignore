# 다운로드 산출물 (로컬 전용)
/downloads/

# 로컬 샘플 미디어 (형상관리 제외)
sample/

# 의존성
app/node_modules/
server/node_modules/

# Spring Boot
backend/target/

# Expo / 네이티브 생성물
app/.expo/
# app/android/ — 온디바이스 yt-dlp(Chaquopy)·커스텀 모듈 포함으로 버전 관리함
app/ios/
app/dist/

# 로그·OS
*.log
.DS_Store
Thumbs.db

# 루트 임시·테스트 파일
/*.json
/*.html

# Whisper 로컬 바이너리/모델 (대용량 산출물)
library/whisper/*.bin
library/whisper/*.dll
library/whisper/*.exe
library/whisper/*.zip
library/whisper/_bin/
library/whisper/_src_whisper_cpp/

# Whisper APK 번들 (모델·CLI — Setup-Whisper.ps1 -AndroidAssets 로 로컬 준비)
app/android/app/src/main/assets/whisper/*

# shineenc APK 번들 (Setup-AndroidShine.ps1 로 로컬 준비)
app/android/app/src/main/assets/shine/*
